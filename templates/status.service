[Unit]
Description=pi-home-stack - collect the system numbers both interfaces read

[Service]
Type=oneshot
# Without this Python buffers its output, and a failed run leaves nothing in the
# journal but "exited 1" with no reason. On an unattended run that journal entry
# is the only trace there is.
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 @STATUS_COLLECTOR@ @STATUS_OUTPUT@
# The collector only reads; everything beyond that is taken away from it.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ReadWritePaths=@STATUS_OUTPUT_DIR@
TimeoutStartSec=60
