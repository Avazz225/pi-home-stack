# Copy to .env for `npm start` (development only). Put your Pi's address here.
# The production build does NOT use this file - it uses .env.production, which
# holds relative paths and needs no editing.

REACT_APP_NW_API_ENDPOINT=http://PI-ADDRESS:5000
REACT_APP_PROFILE_API_ENDPOINT=http://PI-ADDRESS:5001
REACT_APP_TRACKING_API_ENDPOINT=http://PI-ADDRESS:5002
REACT_APP_BACKUP_API_ENDPOINT=http://PI-ADDRESS:5003
REACT_APP_STUDY_API_ENDPOINT=http://PI-ADDRESS:5004
REACT_APP_HOME_API_ENDPOINT=http://PI-ADDRESS:5005
