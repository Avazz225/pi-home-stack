# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# NOTE: /build is deliberately NOT ignored here.
#
# The installer prefers a prebuilt bundle, which is what lets a Pi install the
# dashboard without Node and without pulling half a gigabyte of node_modules.
# That only works if the bundle ships with the repository. The cost is that
# build/ has to be regenerated and committed whenever src/ changes:
#
#     npm ci && CI=false npm run build

# misc
